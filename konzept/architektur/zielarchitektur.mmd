flowchart TB
    besucher(["Besucherinnen und Besucher<br/>Browser, Handy"])
    redaktion(["Redaktion FBN<br/>4 Rollen, Login"])

    subgraph hetzner["Hetzner Cloud · Rechenzentrum in Deutschland"]
        direction TB
        fw{{"Cloud Firewall<br/>nur HTTPS, SSH nur Admin"}}

        subgraph prod["Produktivserver · Docker Compose"]
            direction LR
            caddy["Caddy<br/>Reverse Proxy, HTTPS"]
            web["Web-App · SvelteKit<br/>Website + Redaktion"]
            matomo["Matomo<br/>cookielos"]
            api["API · ASP.NET Core<br/>Inhalte, Workflow, Rechte"]
            db[("PostgreSQL<br/>Inhalte, Versionen,<br/>Protokoll")]
            caddy --> web
            caddy --> matomo
            web -- "REST / JSON" --> api
            api --> db
        end

        storage[("Object Storage<br/>Medien, PDFs,<br/>Spiel-ZIPs")]
        box[("Storage Box<br/>nächtliche Backups")]
        staging["Staging-Server<br/>Abnahme, Schulung"]

        fw --> caddy
        api -- "signierte URLs" --> storage
        db -. "pg_dump" .-> box
    end

    subgraph ci["Auslieferung"]
        direction TB
        repo["Git-Repository"] --> actions["CI: Check, Tests,<br/>Build"] --> registry["Container-<br/>Registry"]
    end

    besucher -- "HTTPS" --> fw
    redaktion -- "HTTPS" --> fw
    registry -. "1. Staging" .-> staging
    registry -- "2. Produktion" --> prod
