{
	"name": "nutztierkosmos",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"icons": "node scripts/generate-icons.mjs",
		"games": "node scripts/sync-games.mjs",
		"diagrams": "mmdc -p konzept/architektur/puppeteer.json -C konzept/architektur/diagramm.css -i konzept/architektur/zielarchitektur.mmd -o konzept/architektur/zielarchitektur.svg -b white && mmdc -p konzept/architektur/puppeteer.json -C konzept/architektur/diagramm.css -i konzept/architektur/demo-architektur.mmd -o konzept/architektur/demo-architektur.svg -b white",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@mermaid-js/mermaid-cli": "^12.2.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource-variable/open-sans": "^5.3.0",
		"fflate": "^0.8.3",
		"material-symbols": "^0.48.3"
	},
	"nutztierkosmos": {
		"gameSources": [
			"../nutztierkosmus spiel",
			"../nutztierkosmos spiel 2"
		]
	}
}
